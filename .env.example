# 1. Supabase Public Config (Client & Server Components)
# Dapatkan dari Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here

# 2. Supabase Secret Role Key (Server-side Only / Admin / Background Jobs)
# PERINGATAN: Jangan pernah mengekspos key ini ke sisi klien!
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key-here

# 3. Application URL (Auth Redirect URL)
# Saat local: http://localhost:3000
# Saat di Vercel: https://mai-hris.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000
